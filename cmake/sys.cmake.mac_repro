set(Kokkos_ENABLE_CUDA Off)
set(Kokkos_ENABLE_CUDA_LAMBDA Off)

# Match the OpenMP runtime to whichever interpreter this build targets,
# which is not necessarily the system one: CMake follows CONDA_PREFIX, so
# configuring from an activated conda environment builds for that
# environment. See cmake/omp_follow_python.cmake for what goes wrong
# otherwise.
include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/omp_follow_python.cmake)

# Same machine as mac, but pydis's segment-segment force kernel is built
# against a vendored, portable log()/atan() (see
# core/pydis/c/calforce/portable_math.c) instead of Apple's libm, so its
# output is bitwise reproducible against a machine using a different libm
# (e.g. mc3_cpu_repro on Linux/glibc). See the SegSegForce.c/ParaDiS-library-
# (SBA) discussion in tests/unit_tests/test1_node_force for why this
# matters and why it is not the default: it trades nothing in accuracy
# (both are ~1ulp implementations of the same function) for
# reproducibility, which most builds don't need.
#
# Pair with mc3_cpu_repro to check the two machines actually agree:
#   ./configure.sh -DSYS=mac_repro ; cmake --build build -j8
#   cd tests/unit_tests/test1_node_force
#   python3 test_segseg_force_pydis_exadis.py --write-ref   # inspect, then
#   cp output/*.npz ref_data/                                # bless once
# A ref_data blessed by either mac_repro or mc3_cpu_repro should then read
# max error 0.0000e+00 for "ParaDiS library (SBA)" on both machines, since
# neither depends on its OS's libm for this kernel any more.
set(PYDIS_BITREPRO_MATH ON)
